# BharatVoice Environment Variables Example

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./bharatvoice.db

# Gnani AI Configuration
# Get your API key from https://app.gnani.ai/voice/
GNANI_API_KEY=your_gnani_api_key_here

# Set true for local development. Set false only when a valid GNANI_API_KEY is configured.
USE_MOCK_GNANI=true

# Gnani Speech-to-Text (STT) Settings
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE_CODE=indic-auto

# Gnani Text-to-Speech (TTS) Settings
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
GNANI_TTS_LANGUAGE=hi-IN
GNANI_TTS_SPEED=1.0
GNANI_TTS_TIMEOUT_SECONDS=30

# Audio constraints
MAX_AUDIO_DURATION_SECONDS=30
MAX_AUDIO_FILE_SIZE_BYTES=10485760
